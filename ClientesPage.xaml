                                    </VerticalStackLayout>
                                </SwipeView>
                        
                                
                            </Frame>
                        </DataTemplate>
                    </CarouselView.ItemTemplate>

                </CarouselView>-->                                                                        
            </Grid>
        </ScrollView>
    </ContentPage.Content>

</ContentPage>
